# Intentionally identical to apps/api/.env.example — apps/api and apps/worker are two
# processes sharing one set of infrastructure/provider credentials (see
# docs/architecture/02-service-architecture.md §3). Keep the two files in sync; if they
# diverge, that's a signal worker needs a credential api doesn't (or vice versa) —
# make that split explicit rather than letting the files silently drift apart.

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- Database & cache (docker-compose provides these locally) ---
DATABASE_URL=postgresql+asyncpg://forgeai:forgeai@localhost:5432/forgeai
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=

# --- OAuth / webhooks (worker verifies/acts on GitHub events during workflow execution) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- LLM provider ---
GOOGLE_GEMINI_API_KEY=

# --- Deployment integrations (Deploy Application workflow) ---
RAILWAY_API_TOKEN=
VERCEL_API_TOKEN=

# --- Observability ---
SENTRY_DSN=
