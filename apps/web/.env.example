# Copy to .env.local (gitignored) and fill in real values. Never commit a populated .env file.
#
# SECURITY: anything prefixed NEXT_PUBLIC_ is bundled into client-side JS and
# readable by anyone who opens devtools — never put a secret behind this prefix.
# See docs/engineering/06-environment-configuration.md.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SSE_BASE_URL=http://localhost:8000
NEXT_PUBLIC_GITHUB_OAUTH_CLIENT_ID=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=development
