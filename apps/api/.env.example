# Copy to .env.local (gitignored) and fill in real values. Never commit a populated .env file.
# Shared verbatim by apps/worker in local dev — both processes need the same DB/queue/
# provider access. See docs/engineering/06-environment-configuration.md for the full catalog
# and which of these are required in staging/production vs. optional locally.

# --- Environment ---
ENVIRONMENT=development
LOG_LEVEL=info

# --- Database & cache (docker-compose provides these locally) ---
DATABASE_URL=postgresql+asyncpg://forgeai:forgeai@localhost:5432/forgeai
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY=

# --- OAuth ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=

# --- LLM provider ---
GOOGLE_GEMINI_API_KEY=

# --- Deployment integrations (Deploy Application workflow) ---
RAILWAY_API_TOKEN=
VERCEL_API_TOKEN=

# --- Observability ---
SENTRY_DSN=

# --- API ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_DEFAULT_PER_MINUTE=60
