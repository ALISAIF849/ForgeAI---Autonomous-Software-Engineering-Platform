# --- Editor / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# --- Alembic (generated local artifacts only — versioned migration files ARE committed) ---
apps/api/alembic/versions/__pycache__/

